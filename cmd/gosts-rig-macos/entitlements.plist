<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's exceptions (a Developer ID build: see build.sh):
     Settings' Choose… asks System Events for macOS' folder chooser (through
     osascript), so the app may send Apple Events. Nothing else is needed:
     no JIT, no unsigned libraries (gphoto2 runs as a program of its own). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
