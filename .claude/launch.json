{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gosts-ctl",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "go run ./cmd/gosts-ctl -addr localhost:8080"
      ],
      "port": 8080
    },
    {
      "name": "gosts",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "go run ./cmd/gosts -addr localhost:8081"
      ],
      "port": 8081
    },
    {
      "name": "gosts-sim",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "go run ./cmd/gosts -addr localhost:8082 -sim -camera sim -config \"${TMPDIR:-/tmp}/gosts-sim.toml\""
      ],
      "port": 8082
    }
  ]
}
