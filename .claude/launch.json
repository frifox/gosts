{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gosts-ctl",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "go run ./cmd/gosts-ctl -addr localhost:8080"
      ],
      "port": 8080
    },
    {
      "name": "gosts-rig",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "go run ./cmd/gosts-rig --listen localhost:8081"
      ],
      "port": 8081
    },
    {
      "name": "gosts-rig-sim",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "go run ./cmd/gosts-rig --listen localhost:8082 --rig sim --camera sim --config \"${TMPDIR:-/tmp}/gosts-rig-sim.toml\" --ctl-config \"${TMPDIR:-/tmp}/gosts-ctl-sim.toml\" --photos \"$HOME/Pictures/gosts-rig-sim\""
      ],
      "port": 8082
    },
    {
      "name": "make install",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "if pgrep -f '/Applications/GoSTS Rig.app/Contents/MacOS/' >/dev/null; then echo 'GoSTS Rig is running: quit it first, then run make install again.'; exit 1; fi; make install"
      ]
    }
  ]
}
